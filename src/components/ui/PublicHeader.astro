---
import DashboardButton from "./DashboardButton";
import logoImage from "../../assets/variedades_santidana_500x500.png";

const { title = "Sistema de Horarios" } = Astro.props;
---

<header class="w-full bg-white shadow-sm">
  <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <img src={logoImage.src} alt="Logo Variedades Santidana" class="w-8 h-8 object-contain" />
      <span class="font-semibold text-lg text-gray-900">
        {title}
      </span>
    </div>

    <!-- BOTÓN DINÁMICO REACT -->
    <div class="flex items-center gap-3">
      <DashboardButton client:only="react" />
    </div>
  </div>
</header>