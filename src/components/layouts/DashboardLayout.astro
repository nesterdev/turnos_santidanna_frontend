---
// src/components/layouts/DashboardLayout.astro
import BaseLayout from "./BaseLayout.astro";
import Sidebar from "../ui/Sidebar.jsx";
import Topbar from "../ui/Topbar.jsx";
import SidebarDrawer from "../ui/SidebarDrawer.jsx";
import InitClient from "../InitClient.astro";

const { title = "Panel" } = Astro.props;
---

<BaseLayout title={`${title} | Sistema de Turnos`}>
  <InitClient />

  <div class="flex h-screen w-full overflow-hidden relative">
    {/* Sidebar Escritorio: Renderizado estrictamente en el cliente */}
    <aside class="hidden md:flex w-64 flex-col bg-white/80 backdrop-blur-xl border-r border-gray-100">
      <Sidebar client:only="react" />
    </aside>

    {/* Sidebar Móvil: Renderizado estrictamente en el cliente */}
    <SidebarDrawer client:only="react" />

    <main class="flex-1 flex flex-col overflow-hidden">
      <header class="h-16 bg-white/70 backdrop-blur-xl flex items-center px-6 border-b border-gray-100">
        <Topbar client:only="react" />
      </header>

      <section class="flex-1 overflow-y-auto px-6 py-6">
        <div class="max-w-7xl mx-auto">
          <slot />
        </div>
      </section>
    </main>
  </div>
</BaseLayout>