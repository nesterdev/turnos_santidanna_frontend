---
import AuthGuard from "../../components/auth/AuthGuard";
import DashboardLayout from "../../components/layouts/DashboardLayout.astro";
import ShiftList from "../../components/shifts/ShiftList.jsx";
---

<DashboardLayout title="Gestión de Turnos">
  <AuthGuard
    allowedRoles={["admin", "supervisor", "super_admin"]}
    client:only="react"
  >
    <ShiftList client:load />
  </AuthGuard>
</DashboardLayout>
