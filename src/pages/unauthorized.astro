---
import BaseLayout from "../components/layouts/BaseLayout.astro";
---

<BaseLayout title="Acceso restringido">
  <div class="min-h-[80vh] flex items-center justify-center">
    <div class="max-w-md w-full bg-white/80 backdrop-blur border rounded-2xl shadow-lg p-8 text-center space-y-6">

      <div class="text-5xl">🚫</div>

      <h1 class="text-2xl font-semibold text-gray-900">
        Acceso restringido
      </h1>

      <p class="text-gray-600">
        No tienes permisos para acceder a esta sección.
        Este módulo está disponible solo para administradores.
      </p>

      <div class="flex gap-4 justify-center">
        <a
          href="/auth/login"
          class="px-5 py-2 rounded-xl bg-gray-900 text-white hover:bg-gray-800 transition"
        >
          Ir al login
        </a>

        <a
          href="/"
          class="px-5 py-2 rounded-xl border border-gray-300 hover:bg-gray-50 transition"
        >
          Ir al inicio
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
